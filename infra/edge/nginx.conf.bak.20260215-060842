user  nginx;
worker_processes  1;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    resolver 127.0.0.11 valid=30s;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 50m;

    server {
        listen 8080;

        # /map/ogc -> MapServer (transparent proxy; client supplies ?map=...&SERVICE=...)
        location /map/ogc {
    include /etc/nginx/snippets/proxy-common.conf;

    proxy_pass http://tsird-mapserver:8080/?map=/etc/mapserver/tsird.map&$args;
    proxy_redirect off;
}

        # /map/ -> tsird-web (preserve original URI)
        location /map/ {
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_pass http://tsird-web:8080$request_uri;
            proxy_redirect off;
        }

        # health
        location = /map/health {
            add_header Content-Type text/plain;
            return 200 'OK';
        }

        # version
        location = /map/version {
            add_header Content-Type application/json;
            return 200 '{"service":"tsird-edge","version":"0.1.0"}';
        }
    }
}
