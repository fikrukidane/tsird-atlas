user  nginx;
worker_processes  1;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    resolver 127.0.0.11 valid=30s;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 50m;

    server {
        listen 8080;

        # /map/ogc -> MapServer (transparent proxy; client supplies ?map=...&SERVICE=...)

        # /map/ogc -> MapServer (camptocamp/mapserver listens on 80 internally)
        
        # /map/ogc -> MapServer (CampToCamp image serves WMS at /)
        # NOTE: We intentionally DO NOT include host-level snippets here.
        
        # /map/ogc -> MapServer (CampToCamp image serves WMS at /)
        # NOTE: Do NOT include host-level snippets here.
        location /map/ogc {
            proxy_set_header Host ;
            proxy_set_header X-Real-IP ;
            proxy_set_header X-Forwarded-For ;
            proxy_set_header X-Forwarded-Proto ;

            # Force map param; preserve query string
            proxy_pass http://tsird-mapserver:80/?map=/etc/mapserver/tsird.map&$args;
            proxy_redirect off;
        }
  
  
  

        # /map/ -> tsird-web (preserve original URI)
        location /map/ {
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_pass http://tsird-web:8080$request_uri;
            proxy_redirect off;
        }

        # health
        location = /map/health {
            add_header Content-Type text/plain;
            return 200 'OK';
        }

        # version
        location = /map/version {
            add_header Content-Type application/json;
            return 200 '{"service":"tsird-edge","version":"0.1.0"}';
        }
    }
}
