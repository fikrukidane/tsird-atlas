            },
            {
              "name": "runner_run_id",
              "value": "={{ $json.body.run_id || '' }}",
              "type": "string"
            },
            {
              "name": "artifact_status",
              "value": "={{ $json.body.status || '' }}",
              "type": "string"
            },
            {
              "name": "action_required",
              "value": "={{ $json.body.status !== 'development' }}",
              "type": "boolean"
            },
            {
              "name": "operator_summary",
              "value": "=Sentinel-1 full DEV acquisition ended {{$json.body.status || 'without a receipt'}}. A successful receipt confirms a complete all-Tabia radar artifact was validated and loaded in DEV only; it does not publish or classify drought, soil moisture, flood, food security or priority.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
