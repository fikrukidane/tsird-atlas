{
  "name": "TSIRD · Sentinel-1 all-weather radar refresh v1 (development)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Manual development run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        120,
        240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 1 * * *"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Scheduled completed-month check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://tsird-drought-runner:8090/runs/sentinel1-radar-monthly-probe/development-test",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Start source probe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        350,
        310
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 202
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Probe accepted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        570,
        310
      ]
    },
    {
      "parameters": {
        "amount": "={{ Math.min(30, 5 * ($runIndex + 1)) }}",
        "unit": "seconds"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Wait for probe",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        780,
        220
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://tsird-drought-runner:8090/runs/{{ $('Start source probe').item.json.body.job_id }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Read probe receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        990,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ ['queued','running'].includes($json.body.status) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Probe still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1210,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "ready"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "New or revised month?",
